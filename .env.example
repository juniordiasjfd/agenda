# =============================================================================
# Agenda — variáveis de ambiente
#
# Copie para `.env` (nunca commitado) e ajuste. Em produção (Render) as
# variáveis ficam no painel do serviço (declaradas no render.yaml); lá o .env
# não existe. Valores abaixo são exemplos — nenhum é real.
# =============================================================================

# --- Django ------------------------------------------------------------------

# Obrigatória em qualquer ambiente. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# No Render é gerada automaticamente (generateValue).
SECRET_KEY='troque-por-uma-chave-aleatoria'

# True só em desenvolvimento. Ausente ou qualquer outro valor = produção.
DEBUG=True

# Hosts aceitos, separados por vírgula. Obrigatória quando DEBUG não é True,
# exceto no Render, que injeta RENDER_EXTERNAL_HOSTNAME (somado
# automaticamente a ALLOWED_HOSTS e, com https://, a CSRF_TRUSTED_ORIGINS).
# Em dev, se omitida, vale localhost,127.0.0.1.
# Ex. com domínio próprio: agenda.scriba.com.br
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens completas (esquema + host) aceitas no CSRF, separadas por vírgula.
# Ex. com domínio próprio: https://agenda.scriba.com.br
CSRF_TRUSTED_ORIGINS=

# Injetada pelo Render; não definir à mão.
# RENDER_EXTERNAL_HOSTNAME=agenda.onrender.com

# --- Banco de dados (PostgreSQL, obrigatório) ---------------------------------

# postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# O usuário precisa de permissão CREATEDB para o pytest criar o banco de testes.
# No Render vem do banco (Internal Database URL), sem digitar.
DATABASE_URL=postgres://usuario:senha@localhost:5432/agenda

# --- Segurança em produção (só têm efeito com DEBUG diferente de True) --------
# HTTP -> HTTPS é feito pelo Render (o Django não redireciona).

# Cookies de sessão e CSRF só por HTTPS. Padrão: True.
SECURE_COOKIES=True
# HSTS em segundos. Começa baixo (300); subir para 31536000 (1 ano) depois
# de validar o HTTPS em produção.
HSTS_SECONDS=300

# --- Limite de tentativas de login (django-axes) ------------------------------

# Bloqueia o par e-mail + IP depois de N falhas, por M minutos.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Quantos proxies confiáveis acrescentam IP ao X-Forwarded-For (Render: 1).
# 0 = usar REMOTE_ADDR. Sem o cabeçalho (runserver), usa REMOTE_ADDR.
PROXY_COUNT=1

# --- Logs (stdout) ------------------------------------------------------------

# Níveis: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
LOG_LEVEL_DJANGO=WARNING
LOG_LEVEL_ROOT=WARNING

# --- gunicorn (produção) -------------------------------------------------------

# PORT é injetada pelo Render.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30

# --- E-mail (SMTP) ----------------------------------------------------------

# Em dev, o backend de console imprime os e-mails no terminal do runserver.
# Em produção: django.core.mail.backends.smtp.EmailBackend
# Para testar o SMTP (mostra o erro real): python manage.py testar_email voce@scriba.com.br
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use no máximo um dos dois (TLS = STARTTLS, normalmente porta 587;
# SSL = porta 465). Valores aceitos: True / False.
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL='Agenda <nao-responder@agenda.local>'
