# =============================================================================
# Agenda — variáveis de ambiente
#
# Copie para `.env` (nunca commitado) e ajuste. Em produção (Render) defina as
# mesmas variáveis no painel do serviço; lá o .env não existe.
# =============================================================================

# --- Django ------------------------------------------------------------------

# Obrigatória em qualquer ambiente. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='troque-por-uma-chave-aleatoria'

# True só em desenvolvimento. Ausente ou qualquer outro valor = produção.
DEBUG=True

# Hosts aceitos, separados por vírgula. Obrigatória quando DEBUG não é True.
# Em dev, se omitida, vale localhost,127.0.0.1.
# Ex. produção: agenda.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens completas (esquema + host) aceitas no CSRF, separadas por vírgula.
# Necessária em produção atrás do proxy HTTPS do Render.
# Ex.: https://agenda.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Banco de dados (PostgreSQL, obrigatório) ---------------------------------

# postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# O usuário precisa de permissão CREATEDB para o pytest criar o banco de testes.
DATABASE_URL=postgres://usuario:senha@localhost:5432/agenda

# --- Segurança em produção (só têm efeito com DEBUG diferente de True) --------

# Redireciona HTTP -> HTTPS. Padrão: True.
SECURE_SSL_REDIRECT=True
# Cookies de sessão e CSRF só por HTTPS. Padrão: True.
SECURE_COOKIES=True

# --- E-mail (SMTP) ----------------------------------------------------------

# Em dev, o backend de console imprime os e-mails no terminal do runserver.
# Em produção: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use no máximo um dos dois (TLS = STARTTLS, normalmente porta 587;
# SSL = porta 465). Valores aceitos: True / False.
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL='Agenda <nao-responder@agenda.local>'
